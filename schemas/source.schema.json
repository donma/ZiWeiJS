{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ziwei-bible/source.schema.json",
  "title": "ZiWei Bible Source",
  "type": "object",
  "required": ["sourceId", "title", "type", "tier"],
  "properties": {
    "sourceId": { "type": "string", "pattern": "^SRC\\.[A-Z0-9._-]+$" },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "era": { "type": "string" },
    "edition": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "classical-text",
        "modern-book",
        "course",
        "implementation",
        "article",
        "community",
        "dataset",
        "other"
      ]
    },
    "tier": { "type": "integer", "minimum": 1, "maximum": 6 },
    "language": { "type": "string" },
    "isbn": { "type": "string" },
    "publisher": { "type": "string" },
    "year": { "type": ["integer", "string"] },
    "url": { "type": "string" },
    "archiveUrl": { "type": "string" },
    "publicationYear": { "type": ["integer", "string"] },
    "editions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["editionId", "title"],
        "properties": {
          "editionId": { "type": "string" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "year": { "type": ["integer", "string"] },
          "url": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" },
    "independenceGroup": { "type": "string", "description": "證據獨立性分組：同一 family 的不同網頁轉錄視為同源，不得各自計為獨立 Tier3" },
    "carrierType": { "type": "string", "description": "載體類型：print / web-transcription / api / dataset 等" },
    "verifiedAgainstOriginal": { "type": "boolean", "description": "是否已與原著/紙本/原典逐字核對" },
    "capturedAt": { "type": "string", "description": "取得日期（ISO 8601）" }
  },
  "additionalProperties": true
}

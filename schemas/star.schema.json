{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ziwei-bible/star.schema.json",
  "title": "ZiWei Bible Star",
  "description": "星曜 registry 條目。canonical 星曜必須有 sources（spec §25）。",
  "type": "object",
  "required": ["id", "category", "tier", "status", "name", "sources", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ZW\\.STAR\\." },
    "category": {
      "enum": ["major", "aux", "malefic", "minor", "period", "interim"]
    },
    "tier": {
      "enum": ["core", "common", "extended"]
    },
    "status": {
      "enum": ["canonical", "variant", "research", "candidate", "deprecated", "undetermined"]
    },
    "name": {
      "type": "object",
      "required": ["zh-TW"],
      "additionalProperties": { "type": "string" }
    },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "entityKind": {
      "enum": ["star", "stage", "cycle-deity", "year-deity", "period-dynamic", "transformation-marker"]
    },
    "shortDesc": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "brightness": {
      "enum": ["miao", "wang", "de", "li", "ping", "bu", "xian"]
    },
    "sources": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SRC\\." }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "runtimePlacement": {
      "type": "object",
      "description": "Star Capability Metadata：此星於各運限層級（大限、小限、流年、流月、流日、流時）是否支援動態落盤（spec 0.6 §20）。",
      "properties": {
        "major-period": { "type": "boolean" },
        "minor-period": { "type": "boolean" },
        "year": { "type": "boolean" },
        "month": { "type": "boolean" },
        "day": { "type": "boolean" },
        "hour": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "note": { "type": "string" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ziwei-bible/profile.schema.json",
  "title": "ZiWei Bible Profile",
  "type": "object",
  "required": ["profileId", "name"],
  "properties": {
    "$schema": { "type": "string" },
    "profileId": { "type": "string" },
    "name": { "type": "object", "additionalProperties": { "type": "string" } },
    "description": { "type": "object", "additionalProperties": { "type": "string" } },
    "timeConvention": {
      "type": "string",
      "enum": ["civil", "true-solar", "local-mean-solar"]
    },
    "dayBoundary": {
      "type": "string",
      "enum": ["midnight", "zi-hour"]
    },
    "yearBoundaryPolicy": {
      "type": "string",
      "description": "年柱換年分界（lunar-new-year：農曆正月初一；lichun：二十四節氣立春）",
      "enum": ["lunar-new-year", "lichun"]
    },
    "monthBoundaryPolicy": {
      "type": "string",
      "description": "流月換月分界（lunar-month：農曆月初；solar-term：節氣月）",
      "enum": ["lunar-month", "solar-term"]
    },
    "leapMonthPolicy": {
      "type": "string",
      "enum": ["mid-month", "same-as-normal", "split", "next-month"]
    },
    "periodRules": {
      "type": "object",
      "description": "目前支援 ageMethod: virtual-age",
      "properties": {
        "ageMethod": { "type": "string", "enum": ["virtual-age"] }
      }
    },
    "ruleOverrides": {
      "type": "object",
      "description": "canonical ruleId -> variant ruleId（所有 variant 統一由此機制控制）",
      "additionalProperties": { "type": "string" }
    },
    "_reserved": {
      "type": "object",
      "description": "未實作或保留之控制欄位（不得宣稱為 runtime 有效）"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ziwei-bible/evidence.schema.json",
  "title": "ZiWei Bible Evidence",
  "type": "object",
  "required": ["evidenceId", "sourceId", "type"],
  "properties": {
    "evidenceId": { "type": "string", "pattern": "^EVD\\.[A-Z0-9._-]+$" },
    "sourceId": { "type": "string", "pattern": "^SRC\\." },
    "ruleId": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["supports", "conflicts", "mentions", "variant-only"]
    },
    "location": {
      "description": "引文位置：字串（卷/頁/條目）或結構化定位",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "volume": { "type": "string" },
            "chapter": { "type": "string" },
            "page": { "type": "string" },
            "section": { "type": "string" },
            "imagePage": { "type": "string" },
            "anchor": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "quote": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}

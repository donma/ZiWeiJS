{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ziwei-bible/evidence.schema.json",
  "title": "ZiWei Bible Evidence",
  "type": "object",
  "required": ["evidenceId", "sourceId", "type"],
  "properties": {
    "evidenceId": { "type": "string", "pattern": "^EVD\\.[A-Z0-9._-]+$" },
    "sourceId": { "type": "string", "pattern": "^SRC\\." },
    "ruleId": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["supports", "conflicts", "mentions", "variant-only"]
    },
    "location": {
      "description": "引文位置：字串（卷/頁/條目）或結構化定位（spec 3rd §P2-1）",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "editionId": { "type": "string" },
            "publisher": { "type": "string" },
            "publicationYear": { "type": ["integer", "string"] },
            "volume": { "type": "string" },
            "chapter": { "type": "string" },
            "page": { "type": "string" },
            "section": { "type": "string" },
            "imagePage": { "type": "string" },
            "anchor": { "type": "string" },
            "archiveUrl": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "editionId": { "type": "string", "description": "引用版本（對應 source.editions[].editionId）" },
    "quote": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "independenceGroup": { "type": "string", "description": "證據獨立分組，例如 quanshu-wikisource-family" },
    "carrierType": { "type": "string", "description": "載體類型：print / web-transcription 等" },
    "verifiedAgainstOriginal": { "type": "boolean", "description": "是否已核對原著" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}

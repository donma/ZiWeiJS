{
  "$schema": "../../../schemas/rule.schema.json",
  "rules": [
    {
      "ruleId": "ZW.CALC.STAR.ZUOFU_YOUBI.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.stars.aux.zuofu-youbi",
      "category": "stars",
      "name": {
        "zh-TW": "安左輔右弼",
        "en": "Place Zuo Fu / You Bi"
      },
      "description": {
        "zh-TW": "左輔辰上起正月順行至生月；右弼戌宮起正月逆行至生月。"
      },
      "inputs": [
        "lunar.month"
      ],
      "logic": {
        "executor": "calcAuxByMonth",
        "params": {
          "tableRef": "stars/aux-tables#byLunarMonth",
          "stars": [
            "ZW.STAR.AUX.ZUOFU",
            "ZW.STAR.AUX.YOUBI",
            "ZW.STAR.AUX.TIANXING",
            "ZW.STAR.AUX.TIANYAO"
          ]
        }
      },
      "outputs": [
        "stars.*"
      ],
      "sourceRefs": [
        "SRC.QUANSHU"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.ZUOYOU",
        "EVD.QUANSHU.ANXING"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：依 SRC.QUANSHU 建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.STAR.CHANGQU.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.stars.aux.chang-qu",
      "category": "stars",
      "name": {
        "zh-TW": "安文昌文曲",
        "en": "Place Wen Chang / Wen Qu"
      },
      "description": {
        "zh-TW": "文昌戌上起子時逆數至生時；文曲辰上起子時順數至生時。"
      },
      "inputs": [
        "hourBranch"
      ],
      "logic": {
        "executor": "calcAuxByHour",
        "params": {
          "tableRef": "stars/aux-tables#byHourBranch",
          "stars": [
            "ZW.STAR.AUX.WENCHANG",
            "ZW.STAR.AUX.WENQU",
            "ZW.STAR.MALEFIC.DIKONG",
            "ZW.STAR.MALEFIC.DIJIE"
          ]
        }
      },
      "outputs": [
        "stars.*"
      ],
      "sourceRefs": [
        "SRC.QUANSHU"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.CHANGQU",
        "EVD.QUANSHU.DIKONGJIE"

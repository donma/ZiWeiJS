    {
      "ruleId": "ZW.CALC.STAR.YEARBRANCH_AUX.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.stars.aux.year-branch",
      "category": "stars",
      "name": {
        "zh-TW": "安火鈴馬鸞喜等年支諸星",
        "en": "Place year-branch stars"
      },
      "description": {
        "zh-TW": "火星鈴星依年支三合局起子時順數至生時；天馬、紅鸞、天喜、孤辰、寡宿、華蓋、咸池等依年支。"
      },
      "inputs": [
        "ganzhi.year.branch",
        "hourBranch"
      ],
      "logic": {
        "executor": "calcAuxByYearBranch",
        "params": {
          "tableRef": "stars/aux-tables#byYearBranch"
        }

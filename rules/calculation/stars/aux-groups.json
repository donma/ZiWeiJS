    {
      "ruleId": "ZW.CALC.STAR.BYMONTH2.001",
      "ruleVersion": "1.0",
      "status": "candidate",
      "scope": "calculation.stars.aux-by-month-2",
      "category": "calculation",
      "name": {
        "zh-TW": "月系雜曜安法（第二組）",
        "en": "Aux stars by lunar month (group 2)"
      },
      "description": {
        "zh-TW": "由 tables/stars/aux-tables.json → byLunarMonth2 查表安月系雜曜；陰煞正月起寅、每月進二宮。"
      },
      "inputs": ["calendar.lunar.month"],
      "logic": {
        "executor": "calcAuxByMonth2",
        "stage": "natal",
        "order": 240
      },
      "outputs": ["chart.stars"],
      "sourceRefs": ["SRC.QUANSHU"],
      "evidenceRefs": ["EVD.QUANSHU.ZAXING", "EVD.IZTRO.AUXGROUPS"],
      "tags": ["stars", "aux"],
      "changeLog": [
        {
          "version": "1.0",
          "type": "rule-add",
          "date": "2026-09-23",
          "note": "Hardening P0-1：補上原本未被任何規則驅動的安星動作（candidate，待 owner 覆核升 canonical）。"
        }
      ]
    },

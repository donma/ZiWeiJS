{
  "$schema": "../../../schemas/rule.schema.json",
  "rules": [
    {
      "ruleId": "ZW.CALC.CALENDAR.SOLAR_LUNAR.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.calendar.conversion",
      "category": "calendar",
      "name": {
        "zh-TW": "國曆農曆轉換",
        "en": "Solar/lunar conversion"
      },
      "description": {
        "zh-TW": "以曆法庫轉換國曆↔農曆，含閏月標記與節氣。"
      },
      "inputs": [
        "input.date",
        "input.calendarType"
      ],
      "logic": {
        "executor": "convertCalendar",
        "stage": "natal",
        "order": 20
      },
      "outputs": [
        "calendar"
      ],
      "sourceRefs": [
        "SRC.LUNAR-TS",
        "SRC.IZTRO"
      ],
      "evidenceRefs": [
        "EVD.CALENDAR.SOLAR_LUNAR"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：依 SRC.MODERN-IMPL-CONSENSUS 建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.CALENDAR.GANZHI.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.calendar.ganzhi",
      "category": "calendar",
      "name": {
        "zh-TW": "四柱干支",
        "en": "Four pillars ganzhi"
      },
      "description": {
        "zh-TW": "年月日時干支，年柱以立春為界（曆法庫行為）。"
      },
      "inputs": [
        "normalized.solar",
        "hourBranch"
      ],
      "logic": {
        "executor": "calcGanzhi",
        "stage": "natal",
        "order": 30
      },
      "outputs": [
        "calendar.ganzhi"
      ],
      "sourceRefs": [
        "SRC.QUANSHU",
        "SRC.LUNAR-TS"
      ],
      "evidenceRefs": [
        "EVD.CALENDAR.GANZHI"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：依 SRC.MODERN-IMPL-CONSENSUS 建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.CALENDAR.TRUESOLAR.001",
      "ruleVersion": "1.2",
      "status": "candidate",
      "scope": "calculation.calendar.true-solar",
      "category": "calendar",
      "name": {
        "zh-TW": "真太陽時校正",
        "en": "True solar time correction"
      },
      "description": {
        "zh-TW": "經度修正 + 均時差近似公式。"
      },
      "inputs": [
        "location.longitude",
        "timezone"
      ],
      "logic": {
        "executor": "calcTrueSolar",
        "stage": "natal",
        "order": 40
      },
      "outputs": [
        "calendar.trueSolarOffsetMinutes"
      ],
      "sourceRefs": [
        "SRC.LUNAR-TS"
      ],
      "evidenceRefs": [
        "EVD.CALENDAR.TRUESOLAR"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.2",
          "type": "evidence-update",
          "date": "2026-09-23",
          "note": "Hardening P1-1 Canonical Evidence Gate：僅有單一 Tier 3 來源（SRC.LUNAR-TS），且均時差為近似式，不足以宣稱 canonical。降為 candidate，待補 Tier 1/2 天文曆算依據或 owner 覆核（見 research/registry.json）。"
        },

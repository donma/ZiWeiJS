{
  "$schema": "../../../schemas/rule.schema.json",
  "rules": [
    {
      "ruleId": "ZW.CALC.CALENDAR.SOLAR_LUNAR.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.calendar.conversion",
      "category": "calendar",
      "name": {
        "zh-TW": "國曆農曆轉換",
        "en": "Solar/lunar conversion"
      },
      "description": {
        "zh-TW": "以曆法庫轉換國曆↔農曆，含閏月標記與節氣。"
      },
      "inputs": [
        "input.date",
        "input.calendarType"
      ],
      "logic": {
        "executor": "convertCalendar",
        "stage": "natal",
        "order": 20
      },
      "outputs": [
        "calendar"
      ],
      "sourceRefs": [
        "SRC.LUNAR-TS",
        "SRC.IZTRO"
      ],
      "evidenceRefs": [
        "EVD.CALENDAR.SOLAR_LUNAR"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.CALENDAR.GANZHI.001",
      "ruleVersion": "1.1",
      "status": "canonical",
      "scope": "calculation.calendar.ganzhi",
      "category": "calendar",
      "name": {
        "zh-TW": "四柱干支",
        "en": "Four pillars ganzhi"
      },
      "description": {
        "zh-TW": "年月日時干支。年柱換年分界由 profile.yearBoundaryPolicy 決定（見 ZW.CALC.CALENDAR.YEAR_BOUNDARY.001），月柱依節氣、日柱依日界、時柱依日干+時支。"
      },
      "inputs": [
        "normalized.solar",
        "hourBranch"
      ],
      "logic": {
        "executor": "calcGanzhi",
        "stage": "natal",
        "order": 30
      },
      "outputs": [
        "calendar.ganzhi"
      ],
      "sourceRefs": [
        "SRC.QUANSHU",
        "SRC.LUNAR-TS"
      ],
      "evidenceRefs": [
        "EVD.CALENDAR.GANZHI"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.1",
          "type": "behavior-change",
          "date": "2026-09-24",
          "note": "修正說明與行為：年柱分界由 yearBoundaryPolicy 明確決定（canonical 預設採農曆正月初一換年，立春制為 variant），移除原誤寫為立春之說明，並清除 stale SRC.MODERN-IMPL-CONSENSUS。"
        },
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.CALENDAR.TRUESOLAR.001",
      "ruleVersion": "1.2",
      "status": "candidate",
      "scope": "calculation.calendar.true-solar",
      "category": "calendar",
      "name": {
        "zh-TW": "真太陽時校正",
        "en": "True solar time correction"
      },
      "description": {
        "zh-TW": "經度修正 + 均時差近似公式。"
      },
      "inputs": [
        "location.longitude",
        "timezone"
      ],
      "logic": {
        "executor": "calcTrueSolar",
        "stage": "natal",
        "order": 40
      },
      "outputs": [
        "calendar.trueSolarOffsetMinutes"
      ],
      "sourceRefs": [
        "SRC.LUNAR-TS"
      ],
      "evidenceRefs": [
        "EVD.CALENDAR.TRUESOLAR"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.2",
          "type": "evidence-update",
          "date": "2026-09-23",
          "note": "Hardening P1-1 Canonical Evidence Gate：僅有單一 Tier 3 來源（SRC.LUNAR-TS），且均時差為近似式，不足以宣稱 canonical。降為 candidate，待補 Tier 1/2 天文曆算依據或 owner 覆核（見 research/registry.json）。"
        },
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.CALENDAR.YEAR_BOUNDARY.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.calendar.year-boundary",
      "category": "calendar",
      "name": {
        "zh-TW": "年柱換年分界（農曆正月初一）",
        "en": "Year pillar boundary (lunar new year)"
      },
      "description": {
        "zh-TW": "年柱以農曆正月初一為換年分界。此為本引擎 canonical 預設；立春制見 variant ZW.CALC.CALENDAR.YEAR_BOUNDARY.V001。"
      },
      "inputs": [
        "normalized.lunar",
        "profile.yearBoundaryPolicy"
      ],
      "logic": {
        "executor": "calcGanzhi",
        "stage": "natal",
        "order": 31,
        "params": {
          "yearBoundaryPolicy": "lunar-new-year"
        }
      },
      "outputs": [
        "calendar.ganzhi.year"
      ],
      "sourceRefs": [
        "SRC.QUANSHU",
        "SRC.LUNAR-TS"
      ],
      "evidenceRefs": [
        "EVD.CALENDAR.YEAR_BOUNDARY"
      ],
      "tags": [
        "core",
        "boundary"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-24",
          "note": "第三輪 Hardening §P0-2：建立年柱分界正式規則。canonical 採農曆正月初一換年；立春制另立 variant V001，是否改列 canonical 由 owner 依 evidence 決定（見 RSH.CALENDAR.YEAR_BOUNDARY）。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.CALENDAR.YEAR_BOUNDARY.V001",
      "ruleVersion": "1.0",
      "status": "variant",
      "variantOf": "ZW.CALC.CALENDAR.YEAR_BOUNDARY.001",
      "scope": "calculation.calendar.year-boundary",
      "category": "calendar",
      "name": {
        "zh-TW": "年柱換年分界（立春）",
        "en": "Year pillar boundary (LiChun)"
      },
      "description": {
        "zh-TW": "年柱以二十四節氣立春（精確時刻）為換年分界。經 profile.ruleOverrides 選用（如 profile 'lichun'）。"
      },
      "inputs": [
        "normalized.lunar",
        "profile.yearBoundaryPolicy"
      ],
      "logic": {
        "executor": "calcGanzhi",
        "stage": "variant",
        "params": {
          "yearBoundaryPolicy": "lichun"
        }
      },
      "outputs": [
        "calendar.ganzhi.year"
      ],
      "sourceRefs": [
        "SRC.QUANSHU",
        "SRC.LUNAR-TS"
      ],
      "evidenceRefs": [
        "EVD.CALENDAR.YEAR_BOUNDARY"
      ],
      "tags": [
        "variant",
        "boundary"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-24",
          "note": "第三輪 Hardening §P0-2：建立立春換年 variant（lunar-typescript getYearInGanZhiExact）。"
        }
      ]
    }
  ]
}

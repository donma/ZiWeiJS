        "EVD.IZTRO.HOROSCOPE.DYNAMIC_STARS"
      ],
      "tags": [
        "period-star",
        "dynamic-star",
        "candidate"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "behavior-change",
          "date": "2026-09-26",
          "note": "0.6 §15–§19 / §46：新增流魁流鉞（year scope），依限運天干查本命魁鉞表；與 iztro horoscope() differential 一致。初始 status=candidate（待古典原文佐證方可升級）。"
        }

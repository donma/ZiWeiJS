      "description": {
        "zh-TW": "流魁、流鉞依限運天干，套用本命天魁天鉞同一年干表（甲戊庚牛羊、乙己鼠猴鄉…）。古典原文未直接給出限運條文，暫以實作 differential 佐證，維持 candidate。"
      },
      "inputs": [
        "periodStem"
      ],
      "logic": {
        "executor": "calcPeriodKuiYue",
        "stage": "on-demand",
        "order": 4010

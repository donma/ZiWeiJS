{
  "$schema": "../../../schemas/rule.schema.json",
  "rules": [
    {
      "ruleId": "ZW.CALC.PERIOD.XIAOXIAN.001",
      "ruleVersion": "0.1",
      "status": "candidate",
      "scope": "calculation.periods.xiaoxian",
      "category": "periods",
      "name": {
        "zh-TW": "起小限（candidate）",
        "en": "Place Xiao Xian (candidate)"
      },
      "description": {
        "zh-TW": "小限一歲起於年支三合局所屬宮位：寅午戌起辰、申子辰起戌、巳酉丑起未、亥卯未起丑；方向不論陰陽，男順女逆。依《紫微斗數全書》卷二安小限訣，並以兩份獨立電子文本逐字核對相符。status=candidate、stage=on-demand：不併入 canonical 限運輸出；性別未知（unknown）時 skip，不猜方向。"
      },
      "inputs": [
        "ganzhi.year.branch",
        "sexForCalculation"
      ],
      "logic": {
        "executor": "calcCandidateXiaoXian",
        "params": {
          "tableRef": "stars/candidate-aux-tables#xiaoXian"
        },
        "stage": "on-demand",
        "order": 2020
      },
      "outputs": [
        "periods.xiaoxian"
      ],
      "sourceRefs": [
        "SRC.QUANSHU.WIKISOURCE",
        "SRC.QUANSHU.DIANCANG"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.XIAOXIAN",
        "EVD.QUANSHU.DIANCANG.XIAOXIAN"
      ],
      "tags": [
        "candidate",
        "phase-c",
        "periods"
      ],
      "changeLog": [
        {
          "version": "0.1",
          "type": "rule-add",
          "date": "2026-09-24",
          "note": "candidate：依《紫微斗數全書》卷二安小限訣建立；方向採『不論陰陽、男順女逆』，與部分現代流派（陰男陽女逆行）不同，已登錄 Research Queue。"
        }
      ]
    }
  ]
}

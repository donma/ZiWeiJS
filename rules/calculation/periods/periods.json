      "ruleId": "ZW.CALC.PERIOD.LIURI.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.periods.day",
      "category": "periods",
      "name": {
        "zh-TW": "流日",
        "en": "Daily period"
      },
      "description": {
        "zh-TW": "流日命宮由流月命宮起初一順數至當日。"
      },
      "inputs": [
        "periods.month",
        "targetDate.day"
      ],
      "logic": {
        "executor": "calcDayPeriod",
        "stage": "period",
        "order": 420
      },
      "outputs": [
        "periods.day"
      ],
      "sourceRefs": [

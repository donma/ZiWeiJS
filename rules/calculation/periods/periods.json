{
  "$schema": "../../../schemas/rule.schema.json",
  "rules": [
    {
      "ruleId": "ZW.CALC.PERIOD.DAXIAN.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.periods.major",
      "category": "periods",
      "name": {
        "zh-TW": "起大限",
        "en": "Major periods (Da Xian)"
      },
      "description": {
        "zh-TW": "由命宮起大限，起歲數=五行局數；陽男陰女順行、陰男陽女逆行，每宮十年。"
      },
      "inputs": [
        "bureau",
        "lifePalace",
        "yinYang",
        "sexForCalculation"
      ],
      "logic": {
        "executor": "calcMajorPeriods",
        "stage": "natal",
        "order": 350
      },
      "outputs": [
        "periods.major"
      ],
      "sourceRefs": [
        "SRC.QUANSHU"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.DAXIAN"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：依 SRC.QUANSHU 建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.PERIOD.LIUNIAN.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.periods.year",
      "category": "periods",
      "name": {
        "zh-TW": "流年",
        "en": "Annual period"
      },
      "description": {
        "zh-TW": "流年以當年太歲地支所在宮為流年命宮；流年干支由當年干支定。"
      },
      "inputs": [
        "targetDate.year"
      ],
      "logic": {
        "executor": "calcYearPeriod",
        "stage": "period",
        "order": 400
      },
      "outputs": [
        "periods.year"
      ],
      "sourceRefs": [
        "SRC.QUANSHU"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.LIUNIAN"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：依 SRC.QUANSHU 建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.PERIOD.LIUYUE.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.periods.month",
      "category": "periods",
      "name": {
        "zh-TW": "流月",
        "en": "Monthly period"
      },
      "description": {
        "zh-TW": "流月命宮由流年命宮起正月順數（canonical；流派差異保留 variant）。"
      },
      "inputs": [
        "periods.year",
        "targetDate.month"
      ],
      "logic": {
        "executor": "calcMonthPeriod",
        "stage": "period",
        "order": 410
      },
      "outputs": [
        "periods.month"
      ],
      "sourceRefs": [
        "SRC.QUANSHU"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.LIUNIAN"
      ],
      "tags": [

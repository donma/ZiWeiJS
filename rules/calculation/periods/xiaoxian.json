{
  "$schema": "../../../schemas/rule.schema.json",
  "rules": [
    {
      "ruleId": "ZW.CALC.PERIOD.XIAOXIAN.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.periods.xiaoxian",
      "category": "periods",
      "name": {
        "zh-TW": "起小限",
        "en": "Place Xiao Xian"
      },
      "description": {
        "zh-TW": "小限一歲起於年支三合局所屬宮位：寅午戌起辰、申子辰起戌、巳酉丑起未、亥卯未起丑；方向不論陰陽，男順女逆。依《紫微斗數全書》卷二安小限訣，並以兩份互相獨立之電子文本（維基文庫、中華典藏網）逐字核對相符。年齡以虛歲（目標農曆年 − 生年農曆年 + 1，與大限同一慣例）。性別未知（unknown）時 skip，不猜方向。"
      },
      "inputs": [
        "ganzhi.year.branch",
        "sexForCalculation",
        "targetDate"
      ],
      "logic": {
        "executor": "calcXiaoXian",
        "params": {
          "tableRef": "stars/aux-supplementary-tables#xiaoXian"
        },
        "stage": "period",
        "order": 2020
      },
      "outputs": [
        "periods.xiaoxian"
      ],
      "sourceRefs": [
        "SRC.QUANSHU.WIKISOURCE",
        "SRC.QUANSHU.DIANCANG"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.XIAOXIAN",
        "EVD.QUANSHU.DIANCANG.XIAOXIAN"
      ],
      "tags": [
        "phase-c",
        "periods"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "behavior-change",
          "date": "2026-09-24",
          "note": "Owner 批准升 canonical（2026-09-24）：改 stage=on-demand→period 並併入限運輸出（chart.periods.xiaoxian）；證據為兩份獨立 Tier3 文本。方向採原文『不論陰陽、男順女逆』（與部分現代流派之陰男陽女逆行不同，見 RSH.PERIOD.XIAOXIAN_DIRECTION）。"
        },
        {
          "version": "0.1",
          "type": "rule-add",
          "date": "2026-09-24",
          "note": "candidate：依《紫微斗數全書》卷二安小限訣建立；方向採『不論陰陽、男順女逆』，與部分現代流派（陰男陽女逆行）不同，已登錄 Research Queue。"
        }
      ]
    }
  ]
}

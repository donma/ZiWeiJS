{
  "$schema": "../../../schemas/rule.schema.json",
  "rules": [
    {
      "ruleId": "ZW.CALC.SIHUA.NATAL.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.transformations.natal",
      "category": "transformations",
      "name": {
        "zh-TW": "生年四化",
        "en": "Natal four transformations"
      },
      "description": {
        "zh-TW": "以生年干查四化表，化祿化權化科化忌落於星曜所在宮。"
      },
      "inputs": [
        "ganzhi.year.stem"
      ],
      "logic": {
        "executor": "calcSihua",
        "params": {
          "tableRef": "transformations/sihua#canonical",
          "scope": "natal"
        },
        "stage": "natal",
        "order": 320
      },
      "outputs": [
        "chart.transformations"
      ],
      "sourceRefs": [
        "SRC.QUANSHU"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.SIHUA"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：依 SRC.QUANSHU 建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.SIHUA.NATAL.V001",
      "ruleVersion": "1.0",
      "status": "variant",
      "variantOf": "ZW.CALC.SIHUA.NATAL.001",
      "scope": "calculation.transformations.natal",
      "category": "transformations",
      "name": {
        "zh-TW": "生年四化（庚干天府化權/天相化科流派）",
        "en": "Natal sihua variant (geng)"
      },
      "description": {
        "zh-TW": "部分流派庚年化權為天府、化科為天相。"
      },
      "inputs": [
        "ganzhi.year.stem"
      ],
      "logic": {
        "executor": "calcSihua",
        "params": {
          "tableRef": "transformations/sihua#canonical",
          "scope": "natal",
          "variantPatch": {
            "geng": {
              "quan": "ZW.STAR.MAJOR.TIANFU",
              "ke": "ZW.STAR.MAJOR.TIANXIANG"
            }
          }
        },
        "stage": "variant"
      },
      "outputs": [
        "chart.transformations"
      ],
      "sourceRefs": [
        "SRC.ZHONGZHOU"
      ],
      "evidenceRefs": [],
      "tags": [
        "variant"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Variant 初版：保留流派差異，未列入 canonical。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.SIHUA.PALACE.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.transformations.palace",
      "category": "transformations",
      "name": {
        "zh-TW": "宮干四化（飛化/自化）",
        "en": "Palace-stem transformations"
      },
      "description": {
        "zh-TW": "以各宮宮干查四化表；飛入他宮為飛化，落本宮為自化。"
      },
      "inputs": [
        "palaces[].stem"
      ],
      "logic": {
        "executor": "calcSihuaPalace",
        "params": {
          "tableRef": "transformations/sihua#canonical",
          "scope": "palace"
        },
        "stage": "natal",
        "order": 330
      },
      "outputs": [
        "chart.transformations"
      ],
      "sourceRefs": [
        "SRC.SIHUA-FEIXING"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.SIHUA"
      ],
      "tags": [
        "core",
        "feihua"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：依 SRC.SIHUA-FEIXING 建立並通過 golden/unit 驗證。"
        }
      ]
    },
    {
      "ruleId": "ZW.CALC.SIHUA.PERIOD.001",
      "ruleVersion": "1.0",
      "status": "canonical",
      "scope": "calculation.transformations.period",
      "category": "transformations",
      "name": {
        "zh-TW": "限運四化",
        "en": "Period transformations"
      },
      "description": {
        "zh-TW": "大限/流年/流月/流日/流時各以其天干查四化表疊加。"
      },
      "inputs": [
        "periods.*.stem"
      ],
      "logic": {
        "executor": "calcSihuaPeriod",
        "params": {
          "tableRef": "transformations/sihua#canonical"
        },
        "stage": "period",
        "order": 440
      },
      "outputs": [
        "chart.transformations"
      ],
      "sourceRefs": [
        "SRC.QUANSHU"
      ],
      "evidenceRefs": [
        "EVD.QUANSHU.SIHUA"
      ],
      "tags": [
        "core"
      ],
      "changeLog": [
        {
          "version": "1.0",
          "type": "evidence-update",
          "date": "2026-09-22",
          "note": "Canonical 初版：依 SRC.QUANSHU 建立並通過 golden/unit 驗證。"
        }
      ]
    }
  ]
}

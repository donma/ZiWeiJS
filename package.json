{
  "name": "ziwei-bible",
  "version": "0.5.0",
  "description": "ZiWeiJS-Bible — machine-readable, traceable and testable Zi Wei Dou Shu reference repository and reference engine.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE-DRAFT.md",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/ziwei-bible.d.ts",
      "import": "./dist/ziwei-bible.esm.js",
      "default": "./dist/ziwei-bible.esm.js"
    },
    "./browser": {
      "types": "./dist/ziwei-bible.d.ts",
      "default": "./dist/ziwei-bible.browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "rules",
    "tables",
    "sources",
    "evidence",
    "profiles",
    "variants"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.ts && node tools/build-types.mjs && tsx tools/build-manifest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:a11y": "playwright test tests/visual/a11y.e2e.ts",
    "validate:rules": "node tools/rule-validator/validate.mjs",
    "validate:sources": "node tools/source-validator/validate.mjs",
    "validate:schemas": "tsx tools/schema-validator/validate.ts",
    "validate:governance": "tsx tools/governance-validator/validate.ts",
    "validate:integrity": "tsx tools/integrity-validator/validate.ts",
    "validate:versions": "tsx tools/rule-version/validate.ts",
    "validate:research": "tsx tools/research-validator/validate.ts",
    "validate:catalogs": "tsx tools/assimilation/validate-catalogs.ts",
    "validate:variants": "tsx tools/variants/validate-catalog.ts",
    "validate:patterns": "tsx tools/patterns/validate-backlog.ts",
    "profiles:gap": "tsx tools/assimilation/profile-gap-audit.ts",
    "profiles:gap:check": "tsx tools/assimilation/profile-gap-audit.ts --check",
    "coverage:bible": "tsx tools/stats/generate.ts",
    "stats:distribution": "tsx tools/stats/distribution.ts",
    "stats:distribution:check": "tsx tools/stats/distribution.ts --check",
    "differential": "tsx tools/differential-runner/iztro-runner.ts",
    "differential:period": "tsx tools/differential-runner/iztro-period-runner.ts",
    "differential:calendar": "tsx tools/calendar-differential/run.ts",
    "verify:golden": "tsx tools/fixture-generator/generate-v2.ts --check && tsx tools/fixture-generator/generate-period.ts --check",
    "verify": "npm run validate:rules && npm run validate:sources && npm run validate:schemas && npm run validate:governance && npm run validate:integrity && npm run validate:versions && npm run validate:research && npm run validate:catalogs && npm run validate:variants && npm run validate:patterns && npm run profiles:gap:check && npm run assimilation:star-gap:check && npm run assimilation:pattern-gap:check && npm run assimilation:capability-report:check && npm run assimilation:zhongzhou-diff:check && npm run stats:distribution:check && npm run differential:calendar -- --check && npm run differential && npm run differential:period && npm run verify:golden && npm run test && npm run build",
    "verify:ui": "npm run test:a11y",
    "assimilation:snapshot": "tsx tools/assimilation/external-snapshot.ts",
    "assimilation:snapshot:check": "tsx tools/assimilation/external-snapshot.ts --check",
    "assimilation:star-gap": "tsx tools/assimilation/star-gap-audit.ts",
    "assimilation:star-gap:check": "tsx tools/assimilation/star-gap-audit.ts --check",
    "assimilation:zhongzhou-diff": "tsx tools/assimilation/zhongzhou-diff-matrix.ts",
    "assimilation:zhongzhou-diff:check": "tsx tools/assimilation/zhongzhou-diff-matrix.ts --check",
    "assimilation:pattern-gap": "tsx tools/assimilation/pattern-gap-audit.ts",
    "assimilation:pattern-gap:check": "tsx tools/assimilation/pattern-gap-audit.ts --check",
    "assimilation:capability-report": "tsx tools/assimilation/external-capability-report.ts",
    "assimilation:capability-report:check": "tsx tools/assimilation/external-capability-report.ts --check",
    "release:smoke:artifacts": "tsx tools/release-validator/artifact-smoke.ts",
    "release:smoke:package": "tsx tools/release-validator/package-smoke.ts",
    "release:smoke": "npm run release:smoke:artifacts && npm run release:smoke:package",
    "release:check": "npm run verify && npm run release:smoke",
    "manifest": "tsx tools/build-manifest.ts"
  },
  "dependencies": {
    "lunar-typescript": "^1.8.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "iztro": "^2.6.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
